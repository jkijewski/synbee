[
  {
    "step_title": "Before you install",
    "items": [
      {
        "type": "multiselect",
        "desc": "SynBee is free software provided \"as is\", without any warranty. Its authors accept no responsibility or liability, under any circumstances, for any damage or loss from installing, using or being unable to use it, including damage to devices, the NAS or its data, and the consequences of automations. You use it entirely at your own risk. Don't rely on it where a failure could endanger people, animals or property. The full text is in DISCLAIMER.md in the package.",
        "subitems": [
          {
            "key": "wizard_disclaimer_read",
            "desc": "I have read this and use SynBee at my own risk",
            "defaultValue": false,
            "validator": {
              "fn": "{var v=arguments[0]; if (!v) return 'Tick this to continue.'; return true;}"
            }
          }
        ]
      }
    ]
  },
  {
    "step_title": "Where to keep data",
    "items": [
      {
        "type": "textfield",
        "desc": "Shared folder for the hub's data: devices, rooms, actions, automations, history and room photos. It's created if it doesn't exist, and kept if you uninstall. Data goes in a 'synbee' folder inside it; keys stay in the package's private folder.",
        "subitems": [
          {
            "key": "wizard_data_share",
            "desc": "Shared folder",
            "defaultValue": "synbee",
            "validator": {
              "allowBlank": false,
              "regex": {
                "expr": "/^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$/",
                "errorText": "Use 1 to 32 letters, digits, '-' or '_'."
              }
            }
          }
        ]
      }
    ]
  },
  {
    "step_title": "Ports",
    "items": [
      {
        "type": "textfield",
        "desc": "Home network port for the hub's web interface and automations. Don't forward it on your router.",
        "subitems": [
          {
            "key": "wizard_internal_port",
            "desc": "Web interface port",
            "defaultValue": "8090",
            "validator": {
              "allowBlank": false,
              "regex": {
                "expr": "/^(102[5-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                "errorText": "Use a port from 1025 to 65535."
              }
            }
          }
        ]
      },
      {
        "type": "textfield",
        "desc": "Port for the SynBee phone app, over TLS. At home it needs nothing else; to use the app away from home, forward this port on your router later (SynBee's App users page explains how).",
        "subitems": [
          {
            "key": "wizard_app_port",
            "desc": "Phone app port",
            "defaultValue": "8443",
            "validator": {
              "allowBlank": false,
              "regex": {
                "expr": "/^(102[5-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                "errorText": "Use a port from 1025 to 65535."
              }
            }
          }
        ]
      }
    ]
  },
  {
    "step_title": "Zigbee coordinator",
    "items": [
      {
        "type": "textfield",
        "desc": "Address of your network Zigbee coordinator (for example an SMLIGHT SLZB-06M with EmberZNet firmware), as host:port; its own web page shows it. You can also set it later on the Gateway page. Only one program may use it at a time, so stop anything else connected to it first. Leave empty to start without a coordinator.",
        "subitems": [
          {
            "key": "wizard_coordinator",
            "desc": "Coordinator address",
            "defaultValue": "",
            "validator": {
              "allowBlank": true,
              "regex": {
                "expr": "/^$|^[A-Za-z0-9.-]{1,253}:[0-9]{1,5}$/",
                "errorText": "Use host:port, for example 192.168.1.50:6638."
              }
            }
          }
        ]
      }
    ]
  },
  {
    "step_title": "Admin password",
    "items": [
      {
        "type": "singleselect",
        "desc": "Only if you've forgotten the hub's admin password: reset it, so the hub asks for a new one. Devices, actions and automations are kept.",
        "subitems": [
          {
            "key": "wizard_keep_password",
            "desc": "Keep the current password",
            "defaultValue": true
          },
          {
            "key": "wizard_reset_password",
            "desc": "Reset the hub's admin password",
            "defaultValue": false
          }
        ]
      }
    ]
  }
]
